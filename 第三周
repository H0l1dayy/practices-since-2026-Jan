//t3，动态分配内存在运算符重载中要及时删除重新分配


#include<iostream>
using namespace std;
class Matrix;

class Matrix {
	int *p;
	int rows, cols;
public:
	Matrix(int r=0, int c=0) :rows(r), cols(c) {
		p = new int[r*c+1];
	}
	Matrix(Matrix &b) {
		rows = b.rows;
		cols = b.cols;
		p = new int[rows*cols+1];
		for (int i = 0; i < rows*cols; i++) {
			p[i] = b.p[i];
		}
	}
	void input() {
		for (int i = 0; i < rows*cols; i++) {
			cin >> p[i];
		}
	}
	Matrix& operator+(Matrix& b);
	Matrix& operator=(Matrix& b) {
		if (rows == 0 || cols == 0) {
			rows = b.rows;
			cols = b.cols;
			delete[]p;
			//一开始没有重新分配p的内存大小，下面＋的重载也是
			p =new int [rows*cols + 1];
			//
			for (int i = 0; i < rows*cols + 1; i++) {
				p[i] = b.p[i];
			}
			return *this;
		}
		else if (rows != b.rows || cols != b.cols) {
			cout << "the two matrix are not the same" << endl;
			return *this;
		}
		else {
			for (int i = 0; i < rows*cols + 1; i++) {
				p[i] = b.p[i];
			}
			return *this;
		}
	}

	void show() {
		int n = cols;
		for (int i = 0; i < rows*cols; i++) {
			int temp = 0;
			cout << p[i] << "  ";
			if ((i + 1 - temp * cols) % n == 0) {
				cout << endl;
				temp++;
			}
		}
	}
	~Matrix() {
		if (p != nullptr) {
			delete[]p;
			p = nullptr;
		}
		//如果p没有被初始化会出问题

	};
};
Matrix new1;
Matrix& Matrix::operator+(Matrix& b) {
	if (rows != b.rows || cols != b.cols)
		cout << "两数组行数列数不同，无法相加" << endl;
	else {
		new1.cols = cols;
		new1.rows = rows;
		delete[]new1.p;
		new1.p = new int[rows*cols + 1];
		for (int i = 0; i < rows*cols; i++) {
			new1.p[i] = p[i] + b.p[i];
		}
		return new1;
	}
}

int main()
{
	int r, c;

	cout << "Please input rows & cols : ";
	cin >> r >> c;
	Matrix A(r, c), B(r, c);
	cout << "Please input the first matrix : ";
	A.input();
	B = A;
	B.show();

	Matrix C(A), D(r + 1, c + 1);
	C.show();
	C = A + B;
	C.show();
	C = D;
	return 0;
}





