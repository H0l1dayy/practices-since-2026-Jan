	ATOM(const char * name=0,int m=0,float w=0);// 构造函数
	void show()
	{
		cout<<"元素符号:"<<symbol<<'\t'<<"元素序号:"<<id<<'\t'<<"原子量:"<<atomicweight<<endl;		
	}
    ~ATOM(){
        delete[]symbol;
    }
};

ATOM::ATOM(const char* name, int m, float w){
   // symbol = new char[strlen(name)+1];
   if(name){
    symbol = new char[strlen(name)+1];
     strcpy_s(symbol,strlen(name)+1,name);
   }
   else{
    symbol =new char[1];
    symbol[0] = '\0';
   }
   
    id = m;
    atomicweight = w;
}

