    num = n;
    ATOM(a.symbol,a.id,a.atomicweight);
    strcpy_s(formula,strlen(name)+1,name);
    formulaweight = atomicweight*num;
}
	*/

void HOMONUCLEAR_MOLECULE::set(ATOM & a,const char *name,int n){
    num = n;
    strcpy_s(symbol ,strlen(a.symbol)+1,a.symbol);
	id = a.id;
	atomicweight = a.atomicweight;
    strcpy_s(formula,strlen(name)+1,name);
    formulaweight = atomicweight*num;
}

void HOMONUCLEAR_MOLECULE::show(){
    cout<<formula<<"构造元素："<<endl<<"元素符号："<<symbol<<" 元素序号："<<id<<" 原子量:"<<atomicweight<<endl;
    cout<<"原子个数："<<num<<" 分子量:"<<formulaweight<<endl;
}

int main()
{
	HOMONUCLEAR_MOLECULE hm[4],x("O",8,16,"臭氧",3);
	ATOM a1("N",7,14),a2("P",15,30.97),a3("Ar",18,39.95);
	hm[0].set(a1,"氮气",2);
	hm[1].set(a2,"白磷",4);
	hm[2].set(a3,"氩气",1);
	hm[3]=x;
	for(int i=0;i<4;i++)
	{
		hm[i].show();		
	}
	return 0;
}
