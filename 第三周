//字符串数组的赋值问题，老问题了
//strcpy_s函数的使用问题
//sizeof加个指针出来的时指针本身的大小不是数组大小
FOOD::FOOD(const char *na, float pr) {
	if (na) {
		if (strlen(na) > 14) { // Name长度为15，最多存储14个字符（含结束符） 
			cout << "name过长" << endl;
			strcpy_s(Name, sizeof(Name), ""); // 过长时设为空字符串 
		}
		else {
			strcpy_s(Name, sizeof(Name), na);
		}
	}
	else {
		strcpy_s(Name, sizeof(Name), ""); // na为null时设为空字符串 
	}
	price = pr;
}
void FOOD::show() {
	cout << Name << "\t" << price << "元" << endl;
}

class COMBO	//套餐类
{
private:
	FOOD ms[10];	//一份套餐最多提供10种食品
	int nums;  //食品的实际种类
	float value;//总价
public:
	COMBO();      //
	COMBO ADD(FOOD & m);	//添加食品    
	friend void show(COMBO & m);  //

};
COMBO::COMBO() {
	nums = 0;
	value = 0;
}
COMBO COMBO::ADD(FOOD & m) {
	ms[nums] = m;
	nums++;
	value += m.price;
	return *this;
}
void show(COMBO & m) {
	cout << m.nums << "种食物" << ":" << endl;
	for (int i = 0; i < m.nums; i++) {
		m.ms[i].show();
	}
	cout << "总价:" << m.value << "元" << endl;
}

int main()
{
	FOOD f1("米饭", 1), f2("青椒土豆丝", 2), f3("烤鸭", 5), f4("麻婆豆腐", 3), f5("菊花叶汤", 2.5);
	COMBO c;
	c.ADD(f1);
	c.ADD(f2);
	c.ADD(f3);
	c.ADD(f4);
	c.ADD(f5);
	show(c);
	return 0;
}
