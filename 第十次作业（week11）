/*
1.如何在类外定义函数
2.把基类成员看成普通成员一样就行
3.老错误，构造时传参是中文字符串，所以构造函数要改成const char*而不是char*
4.在类外定义类内声明的函数时：删掉缺省值
*/

#include<iostream>
#include<cstring>
using namespace std;
 
class ATOM//原子类
{
public:
	char symbol[3];//元素符号
	int id;//元素序号
	float atomicweight;//原子量
public:
	//ATOM(char * name=0,int m=0,float w=0);// 构造函数
	ATOM(const char * name=0,int m=0,float w=0);// 构造函数
	void show()
	{
		cout<<"元素符号:"<<symbol<<'\t'<<"元素序号:"<<id<<'\t'<<"原子量:"<<atomicweight<<endl;		
	}
};

ATOM::ATOM(const char* name, int m, float w){
    strcpy_s(symbol,2,name);
    id = m;
    atomicweight = w;
    symbol[2] = '\0';
}
