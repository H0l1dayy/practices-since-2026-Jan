class HOMONUCLEAR_MOLECULE:public ATOM//单质分子类
{
	char formula[5];//分子符号
	int num;//原子个数
	float formulaweight;//分子量
public:
	HOMONUCLEAR_MOLECULE(const char *name1=0,int m=0,float w=0,const char *name2=0,int n=0):ATOM(name1,m,w)
	{
		if(name2)
			strcpy(formula,name2);
		else
			strcpy(formula,"\0");
		num=n;
		formulaweight=atomicweight*num;
	}
	void set(ATOM & a,const char *name=0,int n=0);// 为对象设定数据成员值
	
	void show();//输出函数
	
	
};
